{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "labels": {
      "app": "orders-api"
    },
    "name": "orders-api",
    "namespace": "orders-api"
  },
  "spec": {
    "clusterIP": "172.20.134.100",
    "clusterIPs": [
      "172.20.134.100"
    ],
    "internalTrafficPolicy": "Cluster",
    "ipFamilies": [
      "IPv4"
    ],
    "ipFamilyPolicy": "SingleStack",
    "ports": [
      {
        "name": "http",
        "port": 8000,
        "protocol": "TCP",
        "targetPort": "http"
      }
    ],
    "selector": {
      "app": "orders-api"
    },
    "sessionAffinity": "None",
    "type": "ClusterIP"
  }
}
