{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "orders-worker",
    "namespace": "orders-worker",
    "labels": {
      "app": "orders-worker"
    },
    "annotations": {
      "cosmotech.io/gmud-id": "RCL000001"
    }
  },
  "spec": {
    "type": "ClusterIP",
    "selector": {
      "app": "orders-worker"
    },
    "ports": [
      {
        "name": "http",
        "port": 8000,
        "targetPort": "http",
        "protocol": "TCP"
      }
    ]
  }
}
