{
  "apiVersion": "autoscaling/v2",
  "kind": "HorizontalPodAutoscaler",
  "metadata": {
    "name": "orders-worker",
    "namespace": "orders-worker"
  },
  "spec": {
    "behavior": {
      "scaleDown": {
        "policies": [
          {
            "periodSeconds": 60,
            "type": "Pods",
            "value": 1
          }
        ],
        "stabilizationWindowSeconds": 300
      },
      "scaleUp": {
        "policies": [
          {
            "periodSeconds": 60,
            "type": "Pods",
            "value": 1
          }
        ],
        "stabilizationWindowSeconds": 0
      }
    },
    "maxReplicas": 4,
    "metrics": [
      {
        "containerResource": {
          "container": "orders-worker",
          "name": "cpu",
          "target": {
            "averageUtilization": 70,
            "type": "Utilization"
          }
        },
        "type": "ContainerResource"
      }
    ],
    "minReplicas": 1,
    "scaleTargetRef": {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "name": "orders-worker"
    }
  }
}
