    {
      "apiVersion": "argoproj.io/v1alpha1",
      "kind": "Application",
      "metadata": {
        "name": "cosmotech-dr-monitoring",
        "namespace": "argocd"
      },
      "spec": {
        "project": "cosmotech-dr-platform",
        "source": {
          "repoURL": "https://prometheus-community.github.io/helm-charts",
          "chart": "kube-prometheus-stack",
          "targetRevision": "93.1.0",
          "helm": {
            "releaseName": "monitoring",
            "skipTests": true,
            "valuesObject": {
              "grafana": {
                "admin": {
                  "existingSecret": "dr-grafana-admin",
                  "userKey": "admin-user",
                  "passwordKey": "admin-password"
                },
                "persistence": {
                  "enabled": true,
                  "storageClassName": "gp3-retain",
                  "size": "5Gi",
                  "existingClaim": "dr-grafana-restored"
                },
                "sidecar": {
                  "dashboards": {
                    "enabled": true,
                    "label": "grafana_dashboard",
                    "searchNamespace": "observability"
                  },
                  "image": {
                    "tag": "2.14.1"
                  },
                  "datasources": {
                    "name": "prometheus-aws-eks-istio-lab-dev"
                  }
                },
                "additionalDataSources": [
                  {
                    "name": "Loki",
                    "uid": "loki",
                    "type": "loki",
                    "url": "http://loki.observability.svc.cluster.local:3100",
                    "access": "proxy"
                  },
                  {
                    "name": "Tempo",
                    "uid": "P214B5B846CF3925F",
                    "type": "tempo",
                    "url": "http://tempo.observability.svc.cluster.local:3200",
                    "access": "proxy"
                  }
                ],
                "defaultDashboardsEnabled": false,
                "nodeSelector": {
                  "cosmotech.io/workload": "stateful"
                }
              },
              "prometheus": {
                "prometheusSpec": {
                  "retention": "24h",
                  "resources": {
                    "requests": {
                      "memory": "256Mi",
                      "cpu": "100m"
                    }
                  },
                  "storageSpec": {
                    "volumeClaimTemplate": {
                      "spec": {
                        "storageClassName": "gp3-retain",
                        "accessModes": [
                          "ReadWriteOnce"
                        ],
                        "resources": {
                          "requests": {
                            "storage": "10Gi"
                          }
                        }
                      }
                    },
                    "disableMountSubPath": true
                  },
                  "image": {
                    "tag": "v3.15.1-distroless"
                  },
                  "nodeSelector": {
                    "cosmotech.io/workload": "stateful"
                  }
                }
              },
              "alertmanager": {
                "alertmanagerSpec": {
                  "replicas": 1,
                  "storage": {
                    "disableMountSubPath": true,
                    "volumeClaimTemplate": {
                      "spec": {
                        "storageClassName": "gp3-retain",
                        "accessModes": [
                          "ReadWriteOnce"
                        ],
                        "resources": {
                          "requests": {
                            "storage": "2Gi"
                          }
                        }
                      }
                    }
                  },
                  "nodeSelector": {
                    "cosmotech.io/workload": "stateful"
                  }
                }
              }
            }
          }
        },
        "destination": {
          "server": "https://kubernetes.default.svc",
          "namespace": "observability"
        },
        "syncPolicy": {
          "automated": {
            "enabled": false,
            "prune": false,
            "selfHeal": false
          },
          "syncOptions": [
            "ServerSideApply=true",
            "RespectIgnoreDifferences=true"
          ]
        },
        "ignoreDifferences": [
          {
            "group": "",
            "kind": "Secret",
            "jsonPointers": [
              "/data"
            ]
          }
        ]
      }
