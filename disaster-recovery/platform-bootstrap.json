    {
      "apiVersion": "argoproj.io/v1alpha1",
      "kind": "Application",
      "metadata": {
        "name": "cosmotech-dr-otel",
        "namespace": "argocd"
      },
      "spec": {
        "project": "cosmotech-dr-platform",
        "source": {
          "repoURL": "https://open-telemetry.github.io/opentelemetry-helm-charts",
          "chart": "opentelemetry-collector",
          "targetRevision": "0.178.2",
          "helm": {
            "releaseName": "otel",
            "skipTests": true,
            "valuesObject": {
              "mode": "deployment",
              "image": {
                "repository": "otel/opentelemetry-collector-k8s"
              },
              "config": {
                "exporters": {
                  "debug": {},
                  "otlp/tempo": {
                    "endpoint": "tempo.observability.svc.cluster.local:4317",
                    "tls": {
                      "insecure": true
                    }
                  },
                  "otlphttp/loki": {
                    "endpoint": "http://loki.observability.svc.cluster.local:3100/otlp"
                  }
                },
                "service": {
                  "pipelines": {
                    "traces": {
                      "exporters": [
                        "otlp/tempo"
                      ]
                    },
                    "metrics": {
                      "exporters": [
                        "debug"
                      ]
                    },
                    "logs": {
                      "exporters": [
                        "otlphttp/loki"
                      ]
                    }
                  }
                }
              },
              "fullnameOverride": "otel-collector-opentelemetry-collector"
            }
          }
        },
        "destination": {
          "server": "https://kubernetes.default.svc",
          "namespace": "observability"
        },
        "syncPolicy": {
          "automated": {
            "enabled": false,
            "prune": false,
            "selfHeal": false
          },
          "syncOptions": [
            "ServerSideApply=true",
            "RespectIgnoreDifferences=true"
          ]
        },
        "ignoreDifferences": [
          {
            "group": "",
            "kind": "Secret",
            "jsonPointers": [
              "/data"
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "argoproj.io/v1alpha1",
      "kind": "Application",
      "metadata": {
        "name": "cosmotech-dr-loki",
        "namespace": "argocd"
      },
      "spec": {
        "project": "cosmotech-dr-platform",
        "source": {
          "repoURL": "https://grafana.github.io/helm-charts",
          "chart": "loki",
          "targetRevision": "7.5.0",
          "helm": {
            "releaseName": "loki",
            "skipTests": true,
            "valuesObject": {
              "fullnameOverride": "loki",
              "deploymentMode": "SingleBinary",
              "loki": {
                "auth_enabled": false,
                "commonConfig": {
                  "replication_factor": 1
                },
                "storage": {
                  "type": "filesystem"
                },
                "schemaConfig": {
                  "configs": [
                    {
                      "from": "2024-04-01",
                      "store": "tsdb",
                      "object_store": "filesystem",
                      "schema": "v13",
                      "index": {
                        "prefix": "index_",
                        "period": "24h"
                      }
                    }
                  ]
                },
                "limits_config": {
                  "retention_period": "24h"
                },
                "compactor": {
                  "retention_enabled": true,
                  "delete_request_store": "filesystem"
                },
                "image": {
                  "tag": "3.7.9"
                }
              },
              "singleBinary": {
                "replicas": 1,
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  }
                },
                "persistence": {
                  "enabled": true,
                  "size": "10Gi",
                  "storageClass": "gp3-retain",
                  "whenScaled": "Retain",
                  "whenDeleted": "Retain",
                  "enableStatefulSetAutoDeletePVC": false
                },
                "nodeSelector": {
                  "cosmotech.io/workload": "stateful"
                }
              },
              "read": {
                "replicas": 0
              },
              "write": {
                "replicas": 0
              },
              "backend": {
                "replicas": 0
              },
              "minio": {
                "enabled": false
              },
              "chunksCache": {
                "enabled": false
              },
              "resultsCache": {
                "enabled": false
              },
              "gateway": {
                "enabled": false
              },
              "lokiCanary": {
                "enabled": false
              },
              "test": {
                "enabled": false
              },
              "sidecar": {
                "image": {
                  "tag": "2.14.1"
                }
              }
            }
          }
        },
        "destination": {
          "server": "https://kubernetes.default.svc",
          "namespace": "observability"
        },
        "syncPolicy": {
          "automated": {
            "enabled": false,
            "prune": false,
            "selfHeal": false
          },
          "syncOptions": [
            "ServerSideApply=true",
            "RespectIgnoreDifferences=true"
          ]
        },
        "ignoreDifferences": [
          {
            "group": "",
            "kind": "Secret",
            "jsonPointers": [
              "/data"
            ]
          }
        ]
      }
    },
